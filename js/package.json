{
  "name": "@klondike-trading/klondike",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript client of the Klondike market data API: trades, merged order books and market overview of crypto pairs across venues, over REST and WebSocket.",
  "license": "MIT",
  "author": "Klondike",
  "homepage": "https://klondike-trading.github.io/klondike-api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klondike-trading/klondike-api.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/klondike-trading/klondike-api/issues"
  },
  "keywords": [
    "klondike",
    "crypto",
    "market data",
    "order book",
    "trades",
    "websocket",
    "capnproto"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "gen:capnp": "sh scripts/gen-capnp.sh",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "capnp-es": "^0.0.16"
  },
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "ws": "^8.22.1"
  }
}
