<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Excel add-in (Excel-DNA). Excel on Windows only: an .xll is a native Windows add-in. The build
    makes bin/<configuration>/<framework>/publish/Klondike-AddIn64-packed.xll, a single file with
    everything but the .NET runtime.
  -->
  <PropertyGroup>
    <!-- An Excel process hosts a single .NET runtime: the net8.0 add-in loads next to other add-ins on .NET 8. -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Klondike.Excel</RootNamespace>
    <AssemblyName>Klondike.Excel</AssemblyName>
    <ExcelAddInName>Klondike</ExcelAddInName>
    <ExcelAddInFileName>Klondike-AddIn</ExcelAddInFileName>
    <ExcelDnaCreate32BitAddIn>true</ExcelDnaCreate32BitAddIn>
    <ExcelDnaCreate64BitAddIn>true</ExcelDnaCreate64BitAddIn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <ProjectReference Include="../Klondike.Excel.Core/Klondike.Excel.Core.csproj" />
  </ItemGroup>
</Project>
